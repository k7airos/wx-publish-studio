APP_PORT=18889
POSTGRES_PASSWORD=
BOOTSTRAP_SECRET=
PUBLISHING_AUTH_MODE=bootstrap
# Optional complete OAuth settings; required when PUBLISHING_AUTH_MODE=oauth.
# PUBLISHING_OAUTH_ISSUER=https://idp.example.com
# PUBLISHING_OAUTH_PORTAL_URL=https://idp.example.com/oauth/authorize
# PUBLISHING_OAUTH_BASE_URL=https://idp.example.com
# PUBLISHING_OAUTH_CLIENT_ID=
# PUBLISHING_OAUTH_CLIENT_SECRET=
# PUBLISHING_OAUTH_REDIRECT_URI=http://127.0.0.1:18889/api/auth/oauth/callback
# 1 = OAuth 登录时按上游会员资格自动开通成员；默认 0。
# PUBLISHING_SELF_PROVISION=0
# 客户可见文案的部署形态：neutral（默认，开源自托管）/ hosted（线上托管部署的原有文案）。
# PUBLISHING_COPY_MODE=neutral
CREDENTIAL_ENCRYPTION_KEY=
PIPELINE_WORKER_TOKEN=
# Worker 镜像：本项目不发布公共镜像，请按 README「获取 Worker 镜像」一节从
# Pipeline 仓库的固定提交自行构建，再把镜像引用填在这里。
# PIPELINE_WORKER_IMAGE=wx-pipeline-worker:0.24.0
# 兼容 /api/v1/wx/* 的公众号中转服务地址；中转服务独立部署，见 README「准备微信中转」。
# ZZHUB_WX_BASE_URL=https://relay.example.com
# 可选：服务统一持有的中转访问令牌。配置后使用者在界面只填 AppID/AppSecret；
# 未配置时使用者在连接向导里填写自己中转服务的访问令牌（PAT）。
# PUBLISHING_RELAY_PAT=
# 可选：微信 API 白名单需要的出口公网 IP。未配置时由使用者在连接向导里自行填写。
# PUBLISHING_WX_WHITELIST_IP=203.0.113.10
# Local development only; Compose supplies these values inside its network.
DATABASE_URL=postgres://studio:CHANGE_ME@127.0.0.1:18890/studio
APP_ORIGIN=http://127.0.0.1:18889
PIPELINE_WORKER_URL=http://127.0.0.1:18887
PUBLISHING_DATA_DIR=./data
# Fixed trusted font file; bytes must match the public cover contract.
# 容器内默认路径；宿主跑测试时用同一份字节，例：apt install fonts-noto-cjk
# TYPESET_ARTICLE_COVER_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Optional explicit legacy image import source; prefix must end with /.
# PUBLISHING_BODY_IMAGE_SOURCE_ORIGIN=https://img.example.com
# PUBLISHING_BODY_IMAGE_SOURCE_PREFIX=/owner/hash/
# These legacy source settings apply only to the original owner. Other owners default to no CDN imports.
# PUBLISHING_BODY_IMAGE_OWNER_SOURCES={"OWNER_UUID":[{"origin":"https://img.example.com","pathPrefix":"/their/files/"}]}
# Optional one-time migration of this product's R1 server-owned accounts only.
# IMPORT_ACCOUNTS_ONCE=1
# ACCOUNTS_FILE=./config/accounts.json
