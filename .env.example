APP_PORT=18889
POSTGRES_PASSWORD=
BOOTSTRAP_SECRET=
PUBLISHING_AUTH_MODE=bootstrap
# 可选：完整的 oauth 配置；PUBLISHING_AUTH_MODE=oauth 时必填。
# 默认（bootstrap）仍然是一个访问口令对应一个使用者。
# PUBLISHING_OAUTH_ISSUER=https://idp.example.com
# PUBLISHING_OAUTH_PORTAL_URL=https://idp.example.com/oauth/authorize
# PUBLISHING_OAUTH_BASE_URL=https://idp.example.com
# PUBLISHING_OAUTH_CLIENT_ID=
# PUBLISHING_OAUTH_CLIENT_SECRET=
# PUBLISHING_OAUTH_REDIRECT_URI=http://127.0.0.1:18889/api/auth/oauth/callback
# 标准 OIDC 服务（Keycloak、Authentik、Zitadel、Authelia 等）：
#   1) 标准发现——只填 issuer，端点会在启动时从
#      {issuer}/.well-known/openid-configuration 读取。
#      PUBLISHING_OAUTH_ISSUER=https://idp.example.com/realms/main
#   2) 显式端点——三个都要填，不会发出任何发现请求。
# PUBLISHING_OAUTH_AUTHORIZATION_ENDPOINT=https://idp.example.com/realms/main/protocol/openid-connect/auth
# PUBLISHING_OAUTH_TOKEN_ENDPOINT=https://idp.example.com/realms/main/protocol/openid-connect/token
# PUBLISHING_OAUTH_USERINFO_ENDPOINT=https://idp.example.com/realms/main/protocol/openid-connect/userinfo
# 1 = 启动时发现 OIDC 端点；0 = 绝不访问外网；auto = 只在没配任何端点时才发现。
# PUBLISHING_OAUTH_DISCOVERY=auto
# 1 = OAuth 登录时按上游会员资格自动开通成员；默认 0。
# PUBLISHING_SELF_PROVISION=0
# 客户可见文案的部署形态：neutral（默认，开源自托管）/ hosted（线上托管部署的原有文案）。
# PUBLISHING_COPY_MODE=neutral
CREDENTIAL_ENCRYPTION_KEY=
PIPELINE_WORKER_TOKEN=
# ---- 镜像来源 ----
# 默认用已发布的公开镜像（多架构，amd64/arm64 都有，公开可拉，不需要镜像仓库账号）：
#   docker compose up -d --wait
# 想从源码构建，改用：docker compose up -d --build --wait
# 想固定到别的版本、或指向自己的 registry 时，取消下面对应行的注释并填写
# **完整镜像引用**（必须是完整 registry 路径；裸名字会被当成 Docker Hub 镜像去拉）。
# APP_IMAGE=ghcr.io/k7airos/wx-publish-studio:0.7.1
# PIPELINE_WORKER_IMAGE=ghcr.io/k7airos/wx-pipeline-worker:0.24.0
# RELAY_IMAGE=ghcr.io/k7airos/wx-relay:0.2.2

# ---- 微信中转 ----
# 模式 A（默认，同栈自带中转）：本行留空，compose 起第 4 个服务 relay，Worker 指向 http://relay:3001。
# 模式 B（外部中转）：本行填你自己的中转地址（实现 /api/v1/wx/* 契约），compose 不起 relay。
# 请就地修改本行，不要把它追加到文件末尾（下面的派生变量依赖本行的取值）。
ZZHUB_WX_BASE_URL=
# 模式 A 专用：同栈中转的 JWT 密钥，生成方式 openssl rand -hex 32。模式 A 下不填会直接报错。
RELAY_JWT_SECRET=
# 模式 A 专用：同栈中转的管理员账号，供 scripts/relay-init.sh 创建管理员并取 PAT 使用。
# 留空时脚本会生成随机口令并写回本文件。
# RELAY_ADMIN_USERNAME=admin
# RELAY_ADMIN_PASSWORD=
# 可选：服务统一持有的中转访问令牌。模式 A 下运行 scripts/relay-init.sh 会自动写入本文件。
# 未配置时使用者在连接向导里填写自己中转服务的访问令牌（PAT）。
# PUBLISHING_RELAY_PAT=
# 可选：微信 API 白名单需要的出口公网 IP。未配置时由使用者在连接向导里自行填写。
# PUBLISHING_WX_WHITELIST_IP=203.0.113.10

# 派生变量：由上面的 ZZHUB_WX_BASE_URL 推导（留空 = 模式 A，填写 = 模式 B）。
# 请勿修改或删除，也请保持它们位于 ZZHUB_WX_BASE_URL 之后。
RELAY_MODE=${ZZHUB_WX_BASE_URL:+external}${ZZHUB_WX_BASE_URL:+}
RELAY_REPLICAS=${ZZHUB_WX_BASE_URL:+0}${ZZHUB_WX_BASE_URL:+}

# 本地开发用；compose 会在自己的网络里提供 DATABASE_URL 与 PIPELINE_WORKER_URL，
# 下面这几行只在「不用 compose、直接在宿主跑」时才需要看。
# APP_ORIGIN 是例外：compose 也需要它，而且必须与浏览器实际访问的 origin 完全一致。
DATABASE_URL=postgres://studio:CHANGE_ME@127.0.0.1:18890/studio
APP_ORIGIN=http://127.0.0.1:18889
PIPELINE_WORKER_URL=http://127.0.0.1:18887
PUBLISHING_DATA_DIR=./data
# 固定的可信字体文件，字节必须与封面合同一致。
# 容器内默认路径；宿主跑测试时用同一份字节（例：apt install fonts-noto-cjk=1:20240730+repack1-1）。
# TYPESET_ARTICLE_COVER_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 可选：允许从外部地址导入既有图片的来源；前缀必须以 / 结尾。
# PUBLISHING_BODY_IMAGE_SOURCE_ORIGIN=https://img.example.com
# PUBLISHING_BODY_IMAGE_SOURCE_PREFIX=/owner/hash/
# 上面这两项按来源白名单授权，只对显式列出的来源生效；不填就是不允许导入外部图片。
# PUBLISHING_BODY_IMAGE_OWNER_SOURCES={"OWNER_UUID":[{"origin":"https://img.example.com","pathPrefix":"/their/files/"}]}
# 可选：一次性导入本产品早期由服务器托管的账号，仅供迁移用，不要长期保留。
# IMPORT_ACCOUNTS_ONCE=1
# ACCOUNTS_FILE=./config/accounts.json
